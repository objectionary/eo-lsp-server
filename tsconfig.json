{
  "compilerOptions": {
    "allowJs": true,
    "lib": [
      "es2020",
      "es2022.error"
    ],
    "module": "preserve",
    "moduleResolution": "bundler",
    "outDir": "tsc-compiled",
    "rootDir": ".",
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "es2020"
  },
  "exclude": [
    "node_modules",
    ".vscode-test"
  ],
  "include": [
    "src"
  ]
}
